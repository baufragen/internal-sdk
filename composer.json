{
	"name": "baufragen/internal-sdk",
	"description": "Handles internal requests to the Baufragen API for things like account creation",
	"authors": [
		{
			"name": "Frank Tiersch",
			"email": "mail@ftiersch.de"
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require": {
		"php": "^8.1",
		"guzzlehttp/guzzle": "^7.9"
	},
	"autoload": {
		"psr-4": {
			"Baufragen\\Sdk\\": "src/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Baufragen\\Sdk\\BaufragenSdkServiceProvider"
			]
		}
	}
}
